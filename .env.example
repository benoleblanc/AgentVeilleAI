# Copier ce fichier en ".env" pour les tests locaux (ne jamais committer le .env réel).
# En production (GitHub Actions), ces valeurs sont fournies via les secrets du dépôt.

# --- Recherche web ---
TAVILY_API_KEY=

# --- Génération du rapport ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Envoi du courriel (ex: Gmail avec mot de passe d'application) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
RECEIVER_EMAIL=beno.leblanc@gmail.com

# --- Optionnel ---
# URL publique du site une fois déployé sur GitHub Pages
SITE_BASE_URL=
